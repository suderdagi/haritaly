# PostgreSQL connection (DIRECT_URL is used by Prisma migrations, e.g. with Supabase/Neon poolers)
DATABASE_URL="postgresql://user:password@localhost:5432/haritaly"
DIRECT_URL="postgresql://user:password@localhost:5432/haritaly"

# Long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=""

# Optional: enables the AI place summary (GET /api/places/:id/summary)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
