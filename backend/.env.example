# PostgreSQL connection. DIRECT_URL is the non-pooled URL Prisma uses for migrations.
# On Vercel, Neon's integration sets DATABASE_URL and DATABASE_URL_UNPOOLED for you
# (scripts/vercel-build.sh uses DATABASE_URL_UNPOOLED when DIRECT_URL is empty).
DATABASE_URL="postgresql://user:password@localhost:5432/haritaly"
DIRECT_URL="postgresql://user:password@localhost:5432/haritaly"

# Long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=""

# Shown on the support, privacy and terms pages. Required for the App Store.
SUPPORT_EMAIL=""

# Optional: photo storage on Vercel Blob (set automatically when a Blob store is connected).
# Without it, photos are saved to public/uploads on local disk.
BLOB_READ_WRITE_TOKEN=""

# Optional: enables the AI place summary (GET /api/places/:id/summary)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
